; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="cascapp"
config/version="1.16"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.09019608, 0.12941177, 0.10980392, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/icon/role.png"
config/icon="res://assets/icon/role.png"

[autoload]

Game="*res://autoload/game_state.gd"
Net="*res://autoload/net_link.gd"
BomberNet="*res://autoload/bomber_net.gd"
Pairing="*res://autoload/pairing.gd"
Sound="*res://autoload/sound.gd"
Nav="*res://autoload/nav.gd"

[display]

window/size/viewport_width=432
window/size/viewport_height=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="cascapp"

[editor_plugins]

enabled=PackedStringArray("res://addons/version_stamp/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=1
